# Copiar a .env y adaptar. Nunca subir .env al repositorio.
APP_ENV=DEMO
APP_URL=http://localhost:3000
AUTH_MODE=DEMO
MAIL_ENABLED=false
MAIL_PROVIDER=SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_NAME=Conecta Bancaribe
MAIL_FROM_ADDRESS=
BRM_NOTIFICATION_RECIPIENT=
ATTACHMENTS_ENABLED=true
ATTACHMENTS_MAX_FILES=5
ATTACHMENTS_MAX_SIZE_MB=10
